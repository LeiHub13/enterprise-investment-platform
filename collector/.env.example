# 复制为 .env；.env 已被 gitignore
COLLECTOR_TOKEN=
BUSINESS_BASE_URL=http://127.0.0.1:8080
QCC_APP_KEY=
QCC_SECRET_KEY=
# 正式监测中的企业信息核验默认关闭，启用前需单独开通 2001 接口
QCC_VERIFY_ON_MONITOR=false
QCC_RECRUITMENT_URL=https://api.qichacha.com/Recruitment/GetList
QCC_SEARCH_PARAM=searchKey
COLLECTOR_INTERVAL_HOURS=24
RABBITMQ_URL=
# 可选：启动事件消费者时使用的用户 Bearer Token（只填原始令牌，不加 Bearer）
AGENT_EVENT_API_TOKEN=
