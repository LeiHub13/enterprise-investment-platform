# Docker Compose 本机开发示例。复制为 .env 并填入实际值；不要提交 .env。
MYSQL_PORT=3306
APP_WEB_PORT=8088
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_JWT_SECRET=
APP_CONTACT_ENCRYPTION_KEY=
APP_OPENAPI_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=
COLLECTOR_TOKEN=
QCC_APP_KEY=
QCC_SECRET_KEY=
# 明确启用后，正式监测才会在有效核验缺失时查询企查查 2001（需单独授权，可能计费）
QCC_VERIFY_ON_MONITOR=false
AGENT_EVENT_API_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AGENT_POSTGRES_USER=agent
AGENT_POSTGRES_PASSWORD=
AGENT_POSTGRES_DB=agent_checkpoints
