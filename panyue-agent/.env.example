# Local development only. Replace all three passwords before starting.
PANYUE_MYSQL_ROOT_PASSWORD=change_this_local_root_password
PANYUE_MYSQL_PASSWORD=change_this_local_app_password
PANYUE_RABBITMQ_PASSWORD=change_this_local_rabbitmq_password

# Loopback-only host ports, chosen to avoid the existing enterprise project.
PANYUE_MYSQL_PORT=13306
PANYUE_REDIS_PORT=16379
PANYUE_RABBITMQ_PORT=15673
PANYUE_RABBITMQ_MANAGEMENT_PORT=25672
PANYUE_BUSINESS_PORT=18080
PANYUE_AGENT_PORT=18081
